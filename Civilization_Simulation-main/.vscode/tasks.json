{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "C/C++: cl.exe build active file",
            "command": "cl.exe",
            "args": [
    			"/Zi",
    			"/EHsc",
    			"/nologo",
    			"/Fe:",
    			"${workspaceFolder}\\symulacja.exe",
    			"/I", "${workspaceFolder}\\include",
    			"/I", "${workspaceFolder}\\..\\SFML-2.6.1\\SFML-2.6.1\\include", 
    			"${workspaceFolder}\\src\\main.cpp",
    			"${workspaceFolder}\\src\\Artifact.cpp",
    			"${workspaceFolder}\\src\\Civilization.cpp",
    			"${workspaceFolder}\\src\\DroppedResource.cpp",
    			"${workspaceFolder}\\src\\Gatherer.cpp",
    			"${workspaceFolder}\\src\\Map.cpp",
    			"${workspaceFolder}\\src\\Resource.cpp",
    			"${workspaceFolder}\\src\\Scout.cpp",
    			"${workspaceFolder}\\src\\Simulation.cpp",
    			"${workspaceFolder}\\src\\Unit.cpp",
    			"${workspaceFolder}\\src\\Warrior.cpp",
				"${workspaceFolder}\\src\\Renderer.cpp",
    			"/link",
    			"/LIBPATH:${workspaceFolder}\\..\\SFML-2.6.1\\SFML-2.6.1\\lib",
    			"sfml-graphics.lib",
    			"sfml-window.lib",
    			"sfml-system.lib"
			],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
